      "system",
      "\"virsh console myvm\"",
      "system",
      "\"sudo useradd -m testuser\"",
      ")",
      "system",
      "\"sudo passwd testuser\"",
      ";",
      "printf",
      "\"Great, we now have a new user account on the virtual machine. Let's disconnect from the console and take a snapshot of the virtual machine.\\n\"",
