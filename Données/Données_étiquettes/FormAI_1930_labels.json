      "printf",
      "(",
      "\"Let's spin up a new virtual machine\\n\"",
      "system",
      "\"virt-install --name=myvm --ram=2048 --vcpus=2 --disk path=/var/lib/libvirt/images/myvm.img,size=20 --graphics none --location=http://mirror.centos.org/centos/7/os/x86_64/ --extra-args='console=ttyS0'\"",
