      "2",
      "printf",
      "\"Suddenly, a ghostly figure appears and rushes towards you! \"",
      "printf",
      "(",
      "\"You try to run but it's too late - the ghost has possessed you.\\n\"",
      "printf",
      "\"GAME OVER\\n\"",
      ";",
      ";",
      "returf",
      "0",
      ";",
      ";",
      "}",
      "elze",
